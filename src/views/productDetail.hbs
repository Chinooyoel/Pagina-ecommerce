{{>head}}

<!-- Modal Alerta Eliminar Producto -->
<div class="modal fade" id="alertaEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Borrar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Estas seguro que desea eliminar <strong>{{product.name}}</strong>?
            </div>
            <div class="modal-footer">
                <a href='{{getUrl 'DELETE_PRODUCT' product.productId }}' class="btn btn-danger">Aceptar</a>
                <a class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        {{#if user.Admin}}
        <section class="col-12 justify-content-end d-flex mt-3">
            <a data-bs-toggle="modal" data-bs-target="#alertaEliminar" class="btn btn-danger me-2">Borrar Producto</a>
            <a href="{{getUrl 'UPDATE_PRODUCT' product.productId}}" class="btn btn-violeta me-2">Editar Producto</a>
            <a href="/admin" class="btn btn-violeta">Inicio</a>
        </section>
        {{/if}}
        <div class="col-12">
            <article class='my-3'>
                <a href='{{getUrl 'PRODUCTS_VIEW' null product.subcategory.category.categoryId null null null}}'
                    class='text-primary'>{{product.subcategory.category.name}}</a> >
                <a href='{{getUrl 'PRODUCTS_VIEW' null null product.subcategory.subcategoryId null null}}'
                    class='text-primary'>{{product.subcategory.name}}</a>
            </article>
            <article class="bg-blanco border row p-3">
                <section class="col-12 col-md-8 my-2">
                    <h2 class='text-center text-md-start' name='nombreProducto' data-id={{ product.productId }}>
                        {{product.name}}</h2>
                    <hr>
                    <img src="/assets/img/producto/{{product.image}}" alt="producto" class='img-fluid img-thumbnail'
                        name='imgProducto'>
                </section>
                <section class="col-12 col-md-4 my-2">
                    <div class='text-center'>
                        <h2 class="h1 textoVerdeOscuro">$<span name='precioProducto'>{{product.price}}</span></h2>
                        <p class='my-1'><strong>PRECIO LISTA ${{ getPriceInPayments product.price 1 }}.00</strong></p>
                    </div>
                    <hr>
                    <div class='d-flex text-secondary align-items-center'>
                        <i class="fas fa-money-bill-wave h2 me-2 text-primary"></i>
                        <div>
                            <p class='my-0'>12 cuotas sin interes de $ {{ getPriceInPayments product.price 12 }}.00 a precio de lista</p>
                            <a class='text-primary'>Ver cuotas</a>
                        </div>
                    </div>
                    <hr>
                    <div class='d-flex align-items-center textoVerdeOscuro'>
                        <i class="fas fa-check-square h2 me-2"></i>
                        <p class='my-0'><strong>STOCK: {{product.stock}}</strong></p>
                    </div>
                    <hr>
                    <div class="d-flex text-secondary align-items-center">
                        <i class="fas fa-archway h2 me-2"></i>
                        <div>
                            <p class='my-0'><strong>RETIRO <span class='textoVerdeOscuro'>GRATIS!</span></strong></p>
                            <p class="my-0">Devoto (CABA)</p>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex text-secondary align-items-center">
                        <i class="fas fa-truck h2 me-2"></i>
                        <div>
                            <p class='my-0'><strong>ENVIO CABA <span class='textoVerdeOscuro'>$300</span></strong></p>
                            <p class="my-0">A toda Capital Federal</p>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex text-secondary align-items-center">
                        <i class="fas fa-truck h2 me-2"></i>
                        <div>
                            <p class='my-0'>Envio a todo el pais</p>
                            <a href="" class="text-primary">Ver costo de envio</a>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex text-primary align-items-center">
                        <i class="fas fa-shield-alt h2 me-2 text-violeta"></i>
                        <div>
                            <p class='my-0'><strong>GARANTÍA</strong></p>
                            <p class='my-0'>{{ product.garantia }}</p>
                        </div>
                    </div>
                    <hr>

                    <div class='text-center'>
                        <button class='btn btn-violeta botonAgregarProducto'>
                            <i class="fas fa-shopping-cart "></i>
                            AÑADIR AL CARRITO</button>
                    </div>
                    <div class='d-flex justify-content-around mt-2'>
                        <p class='my-0 text-secondary'><strong>Marca:</strong> {{product.brand.name}}</p>
                        <p class='my-0 text-secondary'><strong>Código:</strong> {{product.code}}</p>
                    </div>
                </section>
                <section class="col-12">
                    <h6>Descripcion</h6>
                    <pre>{{product.description}}</pre>
                </section>
            </article>
            <h2 class='text-violeta my-3 text-center'>PRODUCTOS RELACIONADOS</h2>
            <div class="flex-wrap d-flex justify-content-center">
                {{#each relatedProducts }}
                <a class="card text-center sombraVerde p-2 w-producto" href="/producto/perfil/{{ productId }}">
                    <img class="card-img-top" src="/assets/img/producto/{{ image }}" alt="" />
                    <section class='card-body' as="section">
                        <p class="text-uppercase my-0">{{ name }}</p>
                    </section>
                    <div>
                        <p class="textoVerde h3 my-0">ARS {{ price }}</p>
                        <p>
                            <strong>18 cuotas de ${{ getPriceInPayments price 18 }}.00</strong>
                        </p>
                        <button class="btn btn-violeta w-100">VER PRODUCTO</button>
                    </div>
                </a>
                {{ else }}
                <p class="text-center w-100">* No hay resultados para esta busqueda *</p>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<script>
    eventoAñadirProducto()
</script>
{{!-- <script>
    copiarEnlace();
</script> --}} --}}
{{>footer}}